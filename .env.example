# Your Gemini API key is required to authenticate with the service.
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Optional: Specify the Gemini model to use.
# If not set, the Gemini CLI will use its default model.
# GEMINI_MODEL=gemini-2.5-pro

# Optional: Specify a custom root directory for Sumika to store its data (workspaces, sessions, etc.).
# If not set, it defaults to ~/.sumika
# SUMIKA_ROOT_DIR=/path/to/your/custom/directory
